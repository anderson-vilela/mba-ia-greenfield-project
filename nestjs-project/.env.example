# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Queue (Valkey/BullMQ)
QUEUE_HOST=valkey
QUEUE_PORT=6379
QUEUE_SWEEP_ABANDONED_UPLOADS_INTERVAL_MS=3600000

# Storage (MinIO/S3-compatible)
STORAGE_ENDPOINT=http://storage:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=streamtube
STORAGE_SECRET_ACCESS_KEY=streamtube
STORAGE_VIDEOS_BUCKET=streamtube-videos
STORAGE_THUMBNAILS_BUCKET=streamtube-thumbnails
STORAGE_PRESIGNED_UPLOAD_URL_TTL_SECONDS=3600
STORAGE_PRESIGNED_STREAM_URL_TTL_SECONDS=300
STORAGE_PRESIGNED_DOWNLOAD_URL_TTL_SECONDS=900
STORAGE_UPLOAD_ABANDONED_TTL_SECONDS=86400
UPLOAD_MAX_FILE_SIZE_BYTES=10737418240
UPLOAD_ACCEPTED_MIME_TYPES=video/mp4,video/webm,video/quicktime
STORAGE_MULTIPART_PART_SIZE_BYTES=104857600
STORAGE_TEST_KEY_PREFIX=test/
